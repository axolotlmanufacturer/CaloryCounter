<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9–11 (API 28–30). Files are included only when the transport is a
    device-to-device transfer; with an <include> present, nothing else is backed up,
    so cloud backup stays empty (PROMPT.md §2.5). The read-only food database is
    shipped with the app and is not transferred.
-->
<full-backup-content>
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer" />
    <exclude domain="database" path="foods.db" />
    <exclude domain="database" path="foods.db-shm" />
</full-backup-content>
